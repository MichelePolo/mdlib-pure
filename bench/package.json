{
  "name": "mdlib-pure-bench",
  "private": true,
  "type": "module",
  "description": "Throughput, bundle size and CommonMark conformance of mdlib-pure vs. popular Markdown libraries. Competitors are dependencies of bench/ only.",
  "license": "MIT",
  "scripts": {
    "bench": "node run.js",
    "bench:quick": "node run.js --quick"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "commonmark": "0.31.2",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.3",
    "marked": "18.1.2",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "snarkdown": "2.0.0"
  }
}
