{
  "name": "ngx-mdlib-pure-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Angular workspace of ngx-mdlib-pure: the library (projects/ngx-mdlib-pure) and its SSR demo (demo/).",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "ng build ngx-mdlib-pure && node scripts/package-files.mjs",
    "build:demo": "ng build demo",
    "test": "node scripts/fresh-deps.mjs && ng test ngx-mdlib-pure --watch=false",
    "start": "node scripts/fresh-deps.mjs && ng serve demo",
    "serve:ssr:demo": "node dist/demo/server/server.mjs",
    "pack": "npm pack ./dist/ngx-mdlib-pure --pack-destination dist"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "express": "^5.1.0",
    "katex": "0.19.1",
    "mdlib-pure": "file:../..",
    "mermaid": "12.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "@vitest/browser-playwright": "5.0.5",
    "ng-packagr": "^22.2.0",
    "playwright": "1.64.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
