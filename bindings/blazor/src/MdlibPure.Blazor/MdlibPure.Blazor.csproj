<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>MdlibPure.Blazor</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      No content fingerprinting: otherwise every app page would carry an import map
      entry for each of the ~110 JS files in wwwroot/dist (Mermaid is split per
      diagram type). Assets are served at stable URLs with ETags and revalidated;
      the JS initializer itself is still fingerprinted by the SDK.
    -->
    <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>

    <PackageId>MdlibPure.Blazor</PackageId>
    <Version>0.1.0</Version>
    <Authors>Michele Polo</Authors>
    <Copyright>Copyright (c) Michele Polo</Copyright>
    <Description>Markdown viewer and editor with live preview for Blazor (.NET 10), in every render mode: Static SSR, Interactive Server, WebAssembly and Auto. Built on mdlib-pure: CommonMark 0.31.2, GFM, math (KaTeX), Mermaid diagrams, containers, definition lists, front matter; safe by default. Includes a C# AST service.</Description>
    <PackageTags>blazor;markdown;commonmark;gfm;editor;preview;katex;mermaid;razor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/MichelePolo/mdlib-pure/tree/main/bindings/blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MichelePolo/mdlib-pure</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Source of wwwroot/dist/mdlib-service.js (bundled by scripts/build-blazor-assets.js), not an asset. -->
    <None Remove="Scripts\**" />
    <Content Remove="Scripts\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MdlibPure.Blazor.Tests" />
  </ItemGroup>

  <!--
    wwwroot/dist/ is generated by `npm run blazor:assets` at the repository root
    (scripts/build-blazor-assets.js) and gitignored. Without it the package would
    build but the elements would never be defined in the browser: fail early.
  -->
  <Target Name="MdlibPureCheckAssets" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\dist\mdlib-element.js') Or !Exists('$(MSBuildProjectDirectory)\wwwroot\dist\mdlib-service.js') Or !Exists('$(MSBuildProjectDirectory)\wwwroot\dist\mermaid\mermaid.js') Or !Exists('$(MSBuildProjectDirectory)\wwwroot\dist\katex\auto-render.js')"
           Code="MDLIB001"
           Text="MdlibPure.Blazor: the browser assets are missing (wwwroot/dist/). Generate them from the repository root with `npm ci` then `npm run blazor:assets`, and build again." />
  </Target>

</Project>
