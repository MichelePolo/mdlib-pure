<Project>
  <!-- Shared by every project under bindings/blazor. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Keep build output next to each project (bin/, obj/), ignored by bindings/blazor/.gitignore. -->
  </PropertyGroup>
</Project>
