{
  "name": "mdlib-pure",
  "version": "0.1.0",
  "description": "Lightweight, zero-dependency, CommonMark-compliant Markdown renderer for the browser. Extensible via plugins, styled with semantic tokens, Tailwind-friendly.",
  "license": "MIT",
  "author": "Michele Polo <michele.polo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichelePolo/mdlib-pure.git"
  },
  "homepage": "https://github.com/MichelePolo/mdlib-pure#readme",
  "bugs": {
    "url": "https://github.com/MichelePolo/mdlib-pure/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/types/entities/index.d.ts",
      "default": "./dist/entities.js"
    },
    "./gfm": {
      "types": "./dist/types/gfm/index.d.ts",
      "default": "./dist/gfm.js"
    },
    "./container": {
      "types": "./dist/types/plugins/container.d.ts",
      "default": "./dist/container.js"
    },
    "./headings": {
      "types": "./dist/types/plugins/headings.d.ts",
      "default": "./dist/headings.js"
    },
    "./adapter": {
      "types": "./dist/types/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./math": {
      "types": "./dist/types/plugins/math.d.ts",
      "default": "./dist/math.js"
    },
    "./mark": {
      "types": "./dist/types/plugins/mark.d.ts",
      "default": "./dist/mark.js"
    },
    "./frontmatter": {
      "types": "./dist/types/plugins/frontmatter.d.ts",
      "default": "./dist/frontmatter.js"
    },
    "./deflist": {
      "types": "./dist/types/plugins/deflist.d.ts",
      "default": "./dist/deflist.js"
    },
    "./theme.css": "./styles/theme.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "docs",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test \"test/**/*.test.ts\" \"templates/**/*.test.ts\"",
    "test:browser": "node --test \"test/browser/**/*.browser.ts\"",
    "spec": "node test/spec-report.ts",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.js",
    "check": "node scripts/check.js",
    "verify": "npm run typecheck && npm test && npm run check && npm run size",
    "gen:entities": "node scripts/gen-entities.js",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "parser",
    "renderer",
    "tailwind",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
